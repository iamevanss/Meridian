# Shared database (used by packages/api and packages/db)
DATABASE_URL="postgresql://user:password@host:5432/meridian?schema=public"

# Backend (packages/api) — deploy target: Railway or Render
PORT=4000
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
ADMIN_JWT_SECRET="replace-with-a-different-long-random-string"
CORS_ORIGIN_WEB="https://your-web-app.vercel.app"
CORS_ORIGIN_ADMIN="https://your-admin-app.vercel.app"

# apps/web (Vercel project #1)
NEXT_PUBLIC_API_URL="https://your-api.up.railway.app"

# apps/admin (Vercel project #2)
NEXT_PUBLIC_API_URL="https://your-api.up.railway.app"

# Uptime bot target (see /packages/api README section)
HEALTHCHECK_PATH="/health"
